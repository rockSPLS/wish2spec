# Образец настроек. Скопируйте файл в .env.local и заполните значения.
# .env.local в репозиторий не попадает (см. .gitignore) — ключ остаётся только у вас.
# Все переменные обязательны, кроме LLM_REASONING_EFFORT и EMBEDDINGS_API_MODEL
# (нужна только при EMBEDDINGS_MODE=api).

# Адрес OpenAI-совместимого сервиса языковой модели.
# Примеры: https://ai-gateway.vercel.sh/v1 (Vercel AI Gateway), https://openrouter.ai/api/v1, https://api.openai.com/v1
LLM_BASE_URL=

# Ключ API этого сервиса
LLM_API_KEY=

# Идентификатор модели в формате сервиса (у Vercel AI Gateway — «провайдер/модель»)
LLM_MODEL=

# Необязательно: сколько «рассуждающей» модели думать перед ответом (параметр reasoning_effort).
# Допустимые значения зависят от модели — например, none, low, medium, high. Чем меньше, тем
# быстрее ответ. Оставьте пустым для модели без рассуждения или если сервис не принимает параметр.
# Рекомендуется none: на демо-заявках вердиктов, совпавших с ожидаемыми, столько же, сколько с low,
# а ответ в разы быстрее (замер — DEV_NOTES.md, v0.1; повторить — npm run measure:reasoning).
LLM_REASONING_EFFORT=

# Эмбеддинги: local — модель скачивается один раз и работает на этом компьютере,
# документы никуда не отправляются; api — через сервис из LLM_BASE_URL тем же ключом.
# Для начала оставьте local.
EMBEDDINGS_MODE=local

# Модель эмбеддингов сервиса — только при EMBEDDINGS_MODE=api
EMBEDDINGS_API_MODEL=
